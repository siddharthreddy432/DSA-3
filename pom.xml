<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.threatintel</groupId>
    <artifactId>kill-chain-correlation-engine</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Threat-Intelligence Kill-Chain Correlation Engine</name>
    <description>Algorithmic correlation engine for threat intelligence and kill-chain analysis built with custom data structures.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <!--
        CRITICAL ARCHITECTURAL RESTRICTION:
        Zero external algorithmic or collection libraries are permitted.
        No Java Collection Framework inside core algorithmic engine.
        No JGraphT, Guava, Apache Commons, or third-party collections.
    -->
    <dependencies>
        <!-- Zero external dependencies in Phase 1 -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>engine.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
